# ==========================================================
# Telegram 频道视频搬运工具 - 配置示例
# 复制本文件为 .env 并填入你自己的值：  cp .env.example .env
# ==========================================================

# --- Telegram API 凭证 ---
# 从 https://my.telegram.org -> "API development tools" 获取
API_ID=1234567
API_HASH=your_api_hash_here

# 会话文件名（首次运行会用手机号+验证码登录，生成 <SESSION_NAME>.session）
SESSION_NAME=forwarder

# --- 频道配置 ---
# 源频道：要监控的频道，可填多个，用英文逗号分隔。
# 支持：@用户名、频道数字ID（如 -1001234567890）、或公开频道链接(t.me/xxx)
SOURCE_CHANNELS=@source_channel_1,@source_channel_2

# 目标频道：搬运到哪里（你必须有该频道的发消息权限，通常是你自己的频道/群）
TARGET_CHANNEL=@my_target_channel

# --- 搬运行为 ---
# 搬运模式：
#   copy    = 重新发送视频，不带"转发自"标签（看起来像原创，默认）
#   forward = 直接转发，保留来源标签
MODE=copy

# 是否保留原始文案/说明文字（True/False），仅在 copy 模式下生效
KEEP_CAPTION=True

# 是否在启动时把每个源频道"最近的历史视频"也搬运一遍（0 表示不搬运历史，只监控新视频）
# 例如填 10，则启动时会先把每个源频道最近 10 条视频搬过去
BACKFILL_LIMIT=0

# 每条搬运之间的延迟秒数（防止触发 Telegram 限流，建议 2~5）
SEND_DELAY=3


# ==========================================================
# Web 面板（仅 web.py 使用）
# ==========================================================
# 面板访问密码。设置后，打开网页需先输入此密码。
# 留空则不启用密码（也可在面板里「设置密码」，那样会存到 settings.json）。
WEB_PASSWORD=

# 监听地址/端口（默认 127.0.0.1:8000；如需局域网/服务器访问设 0.0.0.0）
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 注意：上面 API_ID/SOURCE_CHANNELS 等单账号变量仅在「没有 settings.json」时作为
# 默认账号导入一次。多账号请直接在 Web 面板里添加管理（保存到 settings.json）。
